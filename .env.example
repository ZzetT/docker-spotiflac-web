# SpotiFLAC-Next Headless Environment Configuration

# Host port exposed on your machine (default: 8085)
HOST_PORT=8085

# Directory on host containing your SpotiFLAC-Next .AppImage (default: ./appimage)
# APPIMAGE_PATH=./appimage
APPIMAGE_PATH=

# Configuration and session directory (default: ~/.spotiflac-next)
# For a self-contained NAS/server setup, you can use a local folder:
# CONFIG_PATH=./config
CONFIG_PATH=

# Destination directory on host where downloaded music is saved (default: ./downloads)
# On a NAS, point this to your music share (e.g. /volume1/music or /mnt/user/music):
# DOWNLOADS_PATH=/mnt/music
DOWNLOADS_PATH=

# Container internal Web UI and REST API port (default: 8080)
PORT=8080

# Internal bridge port between WebKit and python server (default: 8081)
BRIDGE_PORT=8081

# Enable diagnostic /eval endpoint (0 = disabled, 1 = enabled)
DEBUG_EVAL=0
